{
  "name": "texptxsnips",
  "displayName": "TeXPtxSnips",
  "description": "Snippets for LaTeX and PreTeXt documents.",
  "version": "0.0.1",
  "publisher": "kylemonette",
  "repository": {
    "type": "git",
    "url": "https://github.com/kylemonette/texptxsnips"
  },
  "bugs": {
    "url": "https://github.com/kylemonette/texptxsnips/issues"
  },
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:latex",
    "onLanguage:pretext"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "latex",
        "extensions": [".tex"]
      },
      {
        "id": "pretext",
        "extensions": [".ptx"]
      }
    ],
    "commands": [
      {
        "command": "texptxsnips.reloadSnippets",
        "title": "TeXPtxSnips: Reload Snippets"
      },
      {
        "command": "texptxsnips.openSnippetsDir",
        "title": "TeXPtxSnips: Open Snippets Directory"
      }
    ],
    "configuration": {
      "title": "TeXPtxSnips",
      "properties": {
        "texptxsnips.snippetsDir": {
          "type": "string",
          "default": "",
          "description": "Directory containing <language>.snips files (e.g. latex.snips, pretext.snips, all.snips). Defaults to a texptxsnips folder alongside VS Code's own User directory."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.125.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
