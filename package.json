{
  "name": "texptxsnips",
  "displayName": "TeXPtxSnips",
  "description": "Snippets for LaTeX and PreTeXt documents.",
  "version": "1.0.1",
  "publisher": "kylemonette",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kylemonette/texptxsnips"
  },
  "homepage": "https://github.com/kylemonette/texptxsnips#readme",
  "bugs": {
    "url": "https://github.com/kylemonette/texptxsnips/issues"
  },
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Snippets"
  ],
  "keywords": [
    "latex",
    "pretext",
    "snippets",
    "math",
    "autocomplete"
  ],
  "activationEvents": [
    "onLanguage:latex",
    "onLanguage:pretext"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "latex",
        "extensions": [
          ".tex"
        ]
      },
      {
        "id": "pretext",
        "extensions": [
          ".ptx"
        ]
      },
      {
        "id": "snips",
        "extensions": [
          ".snips"
        ],
        "aliases": [
          "TeXPtxSnips"
        ],
        "configuration": "./syntaxes/snips.language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "snips",
        "scopeName": "source.snips",
        "path": "./syntaxes/snips.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "texptxsnips.reloadSnippets",
        "title": "TeXPtxSnips: Reload Snippets"
      },
      {
        "command": "texptxsnips.openSnippetsDir",
        "title": "TeXPtxSnips: Open Snippets Directory"
      }
    ],
    "keybindings": [
      {
        "command": "texptxsnips.expandOnTab",
        "key": "tab",
        "when": "editorTextFocus && !editorReadonly && !inSnippetMode && !suggestWidgetVisible && (editorLangId == latex || editorLangId == pretext)"
      }
    ],
    "configuration": {
      "title": "TeXPtxSnips",
      "properties": {
        "texptxsnips.snippetsDir": {
          "type": "string",
          "default": "",
          "description": "Directory containing <language>.snips files (e.g. latex.snips, pretext.snips, all.snips). Defaults to a texptxsnips folder alongside VS Code's own User directory."
        },
        "texptxsnips.debug": {
          "type": "boolean",
          "default": false,
          "description": "Log internal snippet-expansion tracing to the TeXPtxSnips output channel. Off by default; turn on when diagnosing an expansion/chaining bug."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "pkill -f 'agent-host/sdk-cache/claude' || true; npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.125.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
